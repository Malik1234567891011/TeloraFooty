# TeloraFooty backend configuration
# Copy to .env and adjust as needed. Never commit .env.

STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=2000
DEBUG_MODE=true

# Local CV detectors (YOLO player detection). Pulls torch; optional.
ENABLE_ML_DETECTORS=true
BALL_MODEL_PATH=
PLAYER_MODEL_PATH=yolov8n.pt

# Video-language-model judge (primary semantic detector). Needs an API key.
# Get one at https://aistudio.google.com/apikey
ENABLE_VLM=true
GEMINI_API_KEY=
VLM_MODEL=gemini-2.5-flash
VLM_WINDOW_SIZE=8
VLM_STRIDE=6
VLM_MAX_WINDOWS=16
VLM_CONCURRENCY=3

# Demo decision thresholds (false negatives are the enemy).
SHOT_THRESHOLD=0.50
GOAL_THRESHOLD=0.65

# Highlight clip window around a detected shot/goal (seconds).
CLIP_PRE_SECONDS=8
CLIP_POST_SECONDS=4
CLIP_POST_SECONDS_GOAL=6
